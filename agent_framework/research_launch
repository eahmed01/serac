#!/usr/bin/env bash
# Launch the research sandbox container with full ML stack and GPU access.
#
# Usage:
#   agent_framework/research_launch start   # Start the container
#   agent_framework/research_launch stop    # Stop the container
#   agent_framework/research_launch status  # Check if running
#   agent_framework/research_launch logs    # View container logs
#
# The container runs the bundled sandbox server (agent_framework.sandbox),
# which provides a persistent Python namespace with access to PyTorch,
# TensorFlow, and all ML libraries.
#
# Configuration:
# - SERAC_HOST_REPO: host path of the repo to mount read-only at /repo.
#   Required for `start`; the script exits with a clear error if unset.
#
# Security:
# - --network none: no outbound network access
# - --cap-drop ALL: no Linux capabilities
# - --security-opt no-new-privileges: no privilege escalation
# - --read-only: immutable root filesystem
# - --tmpfs /tmp: ephemeral writable /tmp with size limit
# - --gpus '"device=0"': only GPU 0 (GPU 1 is reserved for vLLM)

set -euo pipefail

CONTAINER_NAME="research-sandbox"
IMAGE_NAME="research-sandbox:latest"
HOST_REPO="${SERAC_HOST_REPO:-}"
HOST_WORKSPACE="/tmp/agent_workspace"
UNIX_SOCKET="/tmp/agent_workspace/sandbox.sock"

log() {
    echo "[research_launch] $*" >&2
}

cleanup_old() {
    # Remove any stale container with the same name
    if docker container inspect "$CONTAINER_NAME" &>/dev/null; then
        log "Removing stale container: $CONTAINER_NAME"
        docker rm -f "$CONTAINER_NAME" &>/dev/null
    fi
}

build_image() {
    if ! docker image inspect "$IMAGE_NAME" &>/dev/null; then
        log "Building Docker image: $IMAGE_NAME"
        docker build \
            -f agent_framework/research.Dockerfile \
            -t "$IMAGE_NAME" \
            . || {
            log "Failed to build image"
            return 1
        }
        log "Image built successfully"
    fi
}

cmd_start() {
    # The repo mount source must be configured explicitly.
    if [[ -z "$HOST_REPO" ]]; then
        log "ERROR: SERAC_HOST_REPO is not set. It must point to the host repo to mount at /repo."
        log "  export SERAC_HOST_REPO=/absolute/path/to/your/repo"
        return 1
    fi
    if [[ ! -d "$HOST_REPO" ]]; then
        log "ERROR: SERAC_HOST_REPO points to a directory that does not exist: $HOST_REPO"
        return 1
    fi

    cleanup_old
    build_image

    # Create workspace directory if needed
    mkdir -p "$(dirname "$UNIX_SOCKET")"

    log "Starting research sandbox container (mounting $HOST_REPO -> /repo)..."
    docker run -d \
        --name "$CONTAINER_NAME" \
        --gpus '"device=0"' \
        --network none \
        --cap-drop ALL \
        --security-opt no-new-privileges \
        --read-only \
        --tmpfs /tmp:rw,noexec,nosuid,nodev,size=1g \
        -v "$HOST_REPO:/repo:ro" \
        -v /tmp/agent_workspace:/workspace:rw \
        --user "$(id -u):$(id -g)" \
        -e CUDA_VISIBLE_DEVICES="0" \
        "$IMAGE_NAME" \
        python3 -m agent_framework.sandbox.server

    # Wait for the server to be ready.
    # Readiness check: the sandbox server is the container's PID 1 (it is the
    # docker CMD). The container runs with --network none and the server is
    # started without --socket-path, so it only binds 127.0.0.1:9876 inside
    # its own (empty) network namespace — no TCP or Unix socket is reachable
    # from the host. A connect probe (previously to 127.0.0.1:9876 inside
    # the container) can therefore never succeed, even when healthy.
    # Instead we check what is actually true when the server is up: the
    # agent_framework.sandbox.server process is running as PID 1 and has not
    # exited. (Verified by inspecting /proc/1/cmdline via docker exec.)
    log "Waiting for sandbox server process to come up..."
    for i in {1..30}; do
        if docker exec "$CONTAINER_NAME" python3 -c "
import sys
with open('/proc/1/cmdline', 'rb') as f:
    cmdline = f.read().decode('utf-8', 'replace')
sys.exit(0 if 'agent_framework.sandbox.server' in cmdline else 1)
" 2>/dev/null; then
            log "Sandbox server process is running (PID 1: agent_framework.sandbox.server)"
            return 0
        fi
        sleep 1
    done

    log "ERROR: Sandbox server process was not detected within 30 seconds"
    log "Verify manually: docker logs $CONTAINER_NAME"
    docker logs "$CONTAINER_NAME" >&2
    return 1
}

cmd_stop() {
    if docker container inspect "$CONTAINER_NAME" &>/dev/null; then
        log "Stopping container: $CONTAINER_NAME"
        docker stop "$CONTAINER_NAME"
        docker rm "$CONTAINER_NAME"
        log "Container stopped and removed"
    else
        log "Container not running"
    fi
}

cmd_status() {
    if docker container inspect "$CONTAINER_NAME" &>/dev/null; then
        echo "Running: $(docker inspect --format='{{.State.Running}}' "$CONTAINER_NAME")"
        echo "Started: $(docker inspect --format='{{.State.StartedAt}}' "$CONTAINER_NAME")"
        echo "Exit code: $(docker inspect --format='{{.State.ExitCode}}' "$CONTAINER_NAME")"
    else
        echo "Status: not running"
    fi
}

cmd_logs() {
    docker logs --tail 50 "$CONTAINER_NAME" 2>&1
}

# Main
case "${1:-status}" in
    start)  cmd_start ;;
    stop)   cmd_stop ;;
    status) cmd_status ;;
    logs)   cmd_logs ;;
    *)
        echo "Usage: $0 {start|stop|status|logs}"
        exit 1
        ;;
esac
